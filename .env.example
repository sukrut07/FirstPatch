# =============================================================================
# FirstPatch AI — Environment Variable Configuration
# The Contribution Trust Layer for Open Source
# =============================================================================

# ---- Application & Server ----
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Local Ollama LLM (Default Zero-Cost Private Inference) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_FALLBACK_MODEL=gemma2:2b

# ---- Model Context & Retrieval Parameters ----
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=1536
MAX_RETRIEVED_CHUNKS=12
MAX_EVIDENCE_CHARS=24000
MAX_CONVERSATION_TURNS=8

# ---- GitHub Integration ----
# Optional: Increases rate limit from 60 to 5,000 req/hr
# GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_HTTP_TIMEOUT=30
REPO_CACHE_TTL_SECONDS=3600

# ---- Database ----
DATABASE_URL=sqlite:///./firstpatch.db

# ---- Security ----
SECRET_KEY=firstpatch_ai_secure_token_key_change_in_production

# ---- Cloud LLM / DigitalOcean Gradient™ AI Agentic Cloud (Optional) ----
# Refer to: https://mlh.link/digitalocean-gradient
# DO_GRADIENT_API_KEY=your_digitalocean_gradient_api_key_here
# DO_GRADIENT_WORKSPACE_ID=your_gradient_workspace_id_here
# AI_INFERENCE_PROVIDER=ollama   # options: 'ollama' or 'digitalocean_gradient'
# OPENAI_API_KEY=your_openai_api_key_here

# ---- Gemma 4 Cloud / Google AI Studio API Key (Deep Repository Analysis) ----
# Get a free key at https://aistudio.google.com/
# GEMMA_API_KEY=your_gemma4_or_google_ai_studio_key_here
# GOOGLE_AI_API_KEY=your_google_ai_key_here
# GEMMA_MODEL=gemma-4-31b-it

