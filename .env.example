# FirstPatch AI Environment Configuration

# Local Ollama LLM Configuration (gemma4, gemma4:e2b, gemma4:e4b, or gemma2:2b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Model Context & Generation Parameters
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=1536
MAX_RETRIEVED_CHUNKS=12
MAX_EVIDENCE_CHARS=24000
MAX_CONVERSATION_TURNS=8

# GitHub API (Optional: increases rate limit from 60 to 5,000 req/hr)
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Database
DATABASE_URL=sqlite:///./firstpatch.db

# Server Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# DigitalOcean Gradient™ AI Agentic Cloud (Optional cloud scaling)
# Refer to: https://mlh.link/digitalocean-gradient
# DO_GRADIENT_API_KEY=your_digitalocean_gradient_api_key_here
# DO_GRADIENT_WORKSPACE_ID=your_gradient_workspace_id_here
# AI_INFERENCE_PROVIDER=ollama   # options: 'ollama' or 'digitalocean_gradient'

