# =============================================================================
# FirstPatch AI — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# =============================================================================

# ---- Application ----
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ---- Backend server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- GitHub Integration ----
# Optional: Provide a GitHub personal access token to increase rate limits
# (public repos work without it, but unauthenticated requests are limited
#  to 60/hour). Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ---- Gemma / AI Provider ----
# Supported providers: "google_ai_studio" | "local_ollama" | "none"
AI_PROVIDER=none

# Google AI Studio (https://aistudio.google.com)
# Model supporting Gemma: gemma-3-27b-it or gemma-3-12b-it
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemma-3-27b-it

# Local Ollama (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./firstpatch.db

# ---- Security ----
# Secret used for session signing — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

# ---- Analysis Limits ----
# Maximum number of repository files to inspect during analysis
MAX_FILES_TO_ANALYZE=50
# Maximum issues to retrieve per repository
MAX_ISSUES_PER_REPO=100
# HTTP timeout in seconds for GitHub API calls
GITHUB_HTTP_TIMEOUT=30
# Cache TTL in seconds for repository metadata
REPO_CACHE_TTL_SECONDS=3600
